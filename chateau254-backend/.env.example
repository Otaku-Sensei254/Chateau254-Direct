NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Local Postgres (fallback when offline):
LOCAL_DATABASE_URL=postgresql://postgres:password@localhost:5432/chateau254

# Neon example (primary when online):
DATABASE_URL=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/chateau254?sslmode=require

# Cloudflare R2 menu image storage
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=chateau254
R2_PUBLIC_URL=https://<public-r2-domain>
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MAX_FILE_SIZE=5242880
