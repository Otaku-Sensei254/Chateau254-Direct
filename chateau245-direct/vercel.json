{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/product/[^/]+/?$",
      "dest": "/wines",
      "status": 301
    },
    {
      "src": "^/product-category/.*$",
      "dest": "/wines",
      "status": 301
    },
    {
      "src": "^/shop/?$",
      "dest": "/wines",
      "status": 301
    },
    {
      "src": "^/brand/?$",
      "dest": "/wines",
      "status": 301
    },
    {
      "src": "^/an-unforgettable-evening-of-flavors-fine-wine/?$",
      "dest": "/events",
      "status": 301
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "REACT_APP_API_URL": "https://chateau254-direct-production.up.railway.app/api"
  }
}
